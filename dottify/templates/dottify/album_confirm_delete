{% extends "base.html" %}

{% block content %}
<h1>Delete Album</h1>
<p>Are you sure you want to delete "{{ object.title }}"?</p>

<form method="post">
    {% csrf_token %}
    <button type="submit" class="btn btn-danger">Yes, delete</button>
    <a href="{% url 'album_list' %}" class="btn btn-secondary">Cancel</a>
</form>
{% endblock %}
